# Back-office servi par nginx : un vrai build, pas le serveur de développement.
# Utilisé par docker-compose.coolify.yml ; le Dockerfile voisin reste celui du
# développement local, avec rechargement à chaud.

# --- 1. Compilation --------------------------------------------------------
FROM node:22-slim AS build

WORKDIR /app

COPY package.json package-lock.json* ./
COPY apps/admin/package.json apps/admin/package.json
RUN npm install --workspace apps/admin

COPY apps/admin apps/admin

WORKDIR /app/apps/admin

# L'adresse de l'API est figée dans le JavaScript à la compilation : c'est le
# navigateur qui l'appelle, jamais le conteneur. Elle doit donc être l'adresse
# PUBLIQUE, sans slash final. La changer demande un nouveau déploiement.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# --- 2. Service ------------------------------------------------------------
FROM nginx:1.27-alpine

COPY apps/admin/nginx.conf /etc/nginx/conf.d/default.conf
COPY apps/admin/security-headers.inc /etc/nginx/security-headers.inc
COPY --from=build /app/apps/admin/dist /usr/share/nginx/html

# Deux ports pour le même site : 80, que Coolify utilise quand le domaine n'en
# précise pas, et 47005, celui que la documentation du projet recommande. Ainsi
# le routage fonctionne quel que soit le port saisi dans le champ « Domains ».
EXPOSE 80 47005
