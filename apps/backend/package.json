{
  "name": "@frontiride/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node -e \"require('fs').existsSync('prisma/schema.prisma')&&require('child_process').execSync('npx prisma generate',{stdio:'inherit'})\"",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:staging": "prisma migrate deploy && { tsx prisma/seed.ts || echo \"ATTENTION : le seed a échoué, l'API démarre sans lui\"; } && tsx src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "smoke": "bash scripts/smoke.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.1",
    "@prisma/client": "^5.19.1",
    "agora-token": "^2.0.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "nodemailer": "^10.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^5.19.1",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
