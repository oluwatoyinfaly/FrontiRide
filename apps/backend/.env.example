DATABASE_URL="postgresql://frontiride:frontiride@localhost:47432/frontiride?schema=public"
JWT_SECRET="change-me"
APP_URL="http://localhost:47001"

# Codes de connexion (OTP).
#
# OTP_CHANNELS : « email,sms » (défaut) ou « email » seul pour les essais — le
# téléphone n'est alors pas vérifié et reste marqué comme tel.
#
# Sans SMTP, les codes sont renvoyés dans la réponse de l'API (hors production)
# et journalisés : pratique en local, à ne JAMAIS laisser sur une adresse
# publique. Avec SMTP, le code part par email et n'est plus renvoyé du tout.
# Fournisseurs compatibles : Brevo, Resend (smtp.resend.com), Mailgun, Gmail
# avec mot de passe d'application…
OTP_CHANNELS="email,sms"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="FrontiRide <no-reply@mondomaine.tld>"

# Appels dans l'application (Agora). Laisser vide désactive proprement
# l'option : l'API répond 503 et le mobile ne propose que WhatsApp et
# l'appel téléphonique. Les deux valeurs viennent de console.agora.io.
AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""

# Mobile Money via FeexPay — menu « Développeur » du compte FeexPay. Sans ces
# deux valeurs, seul le paiement en espèces fonctionne.
#
# La sandbox et la production n'ont PAS la même adresse
# (sandbox-api.feexpay.me / api-v2.feexpay.me) : une clé de test envoyée à la
# production est refusée. L'adresse est déduite de la clé (« test_… » = sandbox) ;
# si ta clé de test ne commence pas ainsi, force-la avec FEEXPAY_ENV.
FEEXPAY_TOKEN=""
FEEXPAY_SHOP_ID=""
# FEEXPAY_ENV="sandbox"   # « sandbox » ou « live »

# 47001 : le port que le back-office et le mobile visent par défaut, et
# celui que docker compose publie. Le bloc 47xxx du projet est choisi hors
# des ports de développement usuels, et sous la plage dynamique de Windows
# (49152-65535) que le système attribue tout seul.
PORT=47001
