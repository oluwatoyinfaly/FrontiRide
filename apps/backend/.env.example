DATABASE_URL="postgresql://frontiride:frontiride@localhost:47432/frontiride?schema=public"
JWT_SECRET="change-me"
APP_URL="http://localhost:47001"

FEDAPAY_ENV="sandbox"
FEDAPAY_SECRET_KEY=""

# 47001 : le port que le back-office et le mobile visent par défaut, et
# celui que docker compose publie. Le bloc 47xxx du projet est choisi hors
# des ports de développement usuels, et sous la plage dynamique de Windows
# (49152-65535) que le système attribue tout seul.
PORT=47001
